{
  "name": "rift-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Rift's web dashboard \u2014 settings, moderation, music, stocks, Last.fm and live telemetry for the Rift Discord bot.",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "serve": "node tools/dev-server.mjs --static-only",
    "mock": "node tools/mock-server.mjs",
    "test": "node --test --test-force-exit tests/unit/*.test.mjs tests/integration/*.test.mjs tests/dom/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:dom": "node --test --test-force-exit tests/dom/*.test.mjs",
    "test:watch": "node --test --watch tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
